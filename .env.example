# Application
PORT=3500
NODE_ENV=development
APP_NAME=Office AI Chat
SESSION_SECRET=replace-with-a-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret
BCRYPT_ROUNDS=12

# AI generation provider
# Use "airllm" for Devstral through the WSL FastAPI service.
# Change back to "ollama" for an immediate rollback.
AI_PROVIDER=airllm

# AirLLM / Devstral API
AIRLLM_URL=http://localhost:8001
AIRLLM_API_KEY=devstral-local-secret
AIRLLM_MODEL_LABEL=Devstral-Small-2505-AirLLM
# Start with 1 because this CPU-only setup takes several minutes per token.
# The current Python API accepts a maximum of 32.
AIRLLM_MAX_NEW_TOKENS=1
AIRLLM_TEMPERATURE=0
# Devstral is text-only. "ollama" preserves existing image support; "reject" disables it.
AIRLLM_VISION_FALLBACK=ollama

# Ollama (also used for embeddings and optional image fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM_NAME=Office AI Chat
EMAIL_FROM_ADDRESS=no-reply@example.com
